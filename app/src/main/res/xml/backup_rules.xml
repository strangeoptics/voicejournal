<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Exclude unencrypted private journal & GPS database (plus SQLite WAL/SHM sidecar files) from automatic cloud backup -->
    <exclude domain="database" path="." />
    <!-- Exclude Keystore-encrypted API key preferences and runtime flags -->
    <exclude domain="sharedpref" path="voice_journal_secure_prefs.xml" />
    <exclude domain="sharedpref" path="voice_journal_prefs.xml" />
</full-backup-content>
