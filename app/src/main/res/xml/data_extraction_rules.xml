<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Never upload unencrypted diary entries, GPS movement profiles, or API key preferences to cloud backup -->
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="voice_journal_secure_prefs.xml" />
        <exclude domain="sharedpref" path="voice_journal_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude hardware-bound Keystore ciphertexts and SQLite WAL/SHM files that corrupt Room databases on restore -->
        <exclude domain="sharedpref" path="voice_journal_secure_prefs.xml" />
        <exclude domain="database" path="journal_database-wal" />
        <exclude domain="database" path="journal_database-shm" />
        <exclude domain="database" path="journal_database-journal" />
    </device-transfer>
</data-extraction-rules>
