<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />


    <application
        android:name=".VoiceJournalApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Voicejournal"
        tools:targetApi="31">

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Voicejournal">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.screens.importexport.ImportActivity"
            android:exported="true"
            android:label="Einträge importieren"
            android:theme="@style/Theme.Voicejournal">

            <!-- Filter für Messenger/Mails, die eine spezifische VJ-MimeType beim Teilen oder Öffnen verwenden -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:mimeType="application/vj" />
            </intent-filter>

            <!-- Viel umfassenderer Filter für Dateisystem-Explorer -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />

                <!-- Dateimanager setzen oft MimeTypes, wenn sie Dateiendungen nicht kennen.
                     Um auf ".vj" zu matchen, müssen wir diese gängigen Fallback-MimeTypes akzeptieren -->
                <data android:mimeType="*/*" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/json" />

                <!-- Sehr verlässlicher pathSuffix-Filter (Greift in Android 12+ ein) -->
                <data android:pathSuffix=".vj" />
                <data android:pathSuffix=".VJ" />

                <!-- Reguläre Ausdrücke (pathPattern) als Fallback für ältere Android-Versionen -->
                <data android:pathPattern=".*\\.vj" />
                <data android:pathPattern=".*\\..*\\.vj" />
                <data android:pathPattern=".*\\..*\\..*\\.vj" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.vj" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.vj" />
            </intent-filter>

            <!-- Fallback für Intents KOMPLETT ohne MimeType (sehr selten, aber vorkommend) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:pathSuffix=".vj" />
                <data android:pathSuffix=".VJ" />
                <data android:pathPattern=".*\\.vj" />
                <data android:pathPattern=".*\\..*\\.vj" />
                <data android:pathPattern=".*\\..*\\..*\\.vj" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.vj" />
            </intent-filter>

        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/title_activity_settings" />
        <activity
            android:name=".CategoryManagerActivity"
            android:exported="false"
            android:label="@string/title_activity_category_manager" />
         <activity
            android:name=".EditEntryActivity"
            android:exported="false"
            android:label="@string/title_activity_edit_entry" />
        <activity
            android:name=".EditCategoryActivity"
            android:exported="false"
            android:label="@string/title_activity_edit_category" />
        <activity
            android:name=".CalendarActivity"
            android:exported="false"
            android:label="Calendar" />
        <activity
            android:name=".ui.screens.search.SearchActivity"
            android:exported="false"
            android:label="Search" />

        <service
            android:name=".util.TranscriptionService"
            android:exported="false" />

        <service
            android:name=".WebServerService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>